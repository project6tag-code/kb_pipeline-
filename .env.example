# KB pipeline environment variables - NAMES AND SAFE PLACEHOLDERS ONLY.
#
# Copy to `.env` (git-ignored) next to this file. The scripts in scripts/production/ load it into the process
# environment; the pipeline itself reads only real environment variables.
# NEVER put a real password in this file or in any committed file: keep passwords in
# %APPDATA%\postgresql\pgpass.conf (libpq reads it) and leave ":password" out of every URL.
# Docs: README_PRODUCTION.md, docs/local_runbook.md, docs/migrations_kbp.md, docs/cc_fact_kb_v2.md.

# ---- Database connections (format: postgresql+psycopg://<user>@<host>:<port>/<database>) -----------------------
# Every command also needs --expect-database <name>; it must equal KB_EXPECTED_DATABASE AND the database actually reached.
# Default for local testing: kb_pipeline_test. Set your production database name here (lower-case letters, digits, underscore;
# data_collection_pipeline, postgres and template databases are always refused).
# REQUIRED IN PRODUCTION: uncomment and set your database name (it must also be the database in the two URLs below).
# KB_EXPECTED_DATABASE=kb_pipeline_test
# Runtime role kb_pipeline_app: workers, Gold publisher, `app.pipeline.cli`. REQUIRED.
# ":CHANGE_ME" is a placeholder: DELETE it (leave "user@host") and keep the password in pgpass.conf. check_setup.ps1
# fails while a placeholder is left in.
KB_DATABASE_URL=postgresql+psycopg://kb_pipeline_app:CHANGE_ME@localhost:5432/kb_pipeline_test
# Migration / registration role kb_pipeline_migrator (owner of schema kbp): Alembic and one-time registrations only.
KB_MIGRATION_DATABASE_URL=postgresql+psycopg://kb_pipeline_migrator:CHANGE_ME@localhost:5432/kb_pipeline_test
# Administrator (postgres) for the one-time public-table steps only (bridge bootstrap, Gold V2 patch). Leave unset
# in day-to-day operation; never use it for runs.
# KB_ADMIN_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/kb_pipeline_test

# ---- Runtime sizing (optional; defaults shown) --------------------------------------------------------------
# KB_DB_POOL_SIZE=5
# KB_DB_POOL_TIMEOUT_SECONDS=30
# KB_WORKER_LEASE_SECONDS=300
# KB_WORKER_POLL_SECONDS=5
# KB_WORKER_CLAIM_BATCH=1

# ---- Common Crawl (the only production source) --------------------------------------------------------------
# Profile: `reference` plans only the curated fact publishers (app/sources/commoncrawl/reference_domains_v1.json,
# or the list below); `open` samples the whole crawl with the strict URL policy. `app.pipeline.cli run` sets this
# per stage (--cc-profile); set it here only when running the stage CLIs by hand.
# KB_CC_PROFILE=reference
# KB_CC_REFERENCE_DOMAINS=cdc.gov,nih.gov,who.int
# Which crawl(s): newest N crawls, or explicit ids (each must be listed by index.commoncrawl.org).
# KB_CC_CRAWL_WINDOW=1
# KB_CC_CRAWLS=CC-MAIN-2024-33
# Safe initial limits: 1 block (~3,000 index lines) per partition, 2 partitions.
# KB_CC_BLOCKS_PER_PARTITION=1
# KB_CC_MAX_PARTITIONS_PER_CRAWL=2
# KB_CC_PARTITION_STRIDE=1
# KB_CC_MIME_TYPES=text/html,application/xhtml+xml
# KB_CC_LANGUAGES=eng
# KB_CC_REJECT_TRUNCATED=true
# KB_CC_MAX_RECORD_BYTES=5242880
# KB_CC_MAX_DECOMPRESSED_RECORD_BYTES=33554432
# Bronze evidence store and disk guard (stops writing below this much free space).
# KB_CC_BRONZE_ROOT=data/bronze/commoncrawl
# KB_CC_MIN_FREE_BYTES=10737418240
# Politeness / throughput: parallel range requests per worker and batch size.
# KB_CC_FETCH_CONCURRENCY=4
# KB_CC_BATCH_SIZE=50
# KB_CC_CONNECT_TIMEOUT_SECONDS=10
# KB_CC_READ_TIMEOUT_SECONDS=30
# KB_CC_REQUEST_DEADLINE_SECONDS=120
# KB_CC_ITEM_TRANSIENT_LIMIT=3
# Identify yourself to Common Crawl: add a contact address (printable ASCII, max 200 characters).
# KB_CC_USER_AGENT=kb-pipeline-cc-acquisition/1.0 (contact: ops@example.com)

# ---- Silver preprocessing (optional; every threshold is part of the persisted version labels) ---------------
# KB_SILVER_NEAR_INDEX=data/silver/near_index.sqlite3
# KB_SILVER_TAXONOMY=
# KB_SILVER_QUALITY_THRESHOLD=0.60
# KB_SILVER_SUITABILITY_PASS=0.60
# KB_SILVER_SUITABILITY_FAIL=0.40
# KB_SILVER_LANGUAGE_MIN_CONFIDENCE=0.80
# KB_SILVER_NEAR_DUPLICATE_THRESHOLD=0.80

# ---- Chunk near-dedup side index (rebuildable from PostgreSQL) ----------------------------------------------
# Default: data/chunk_dedup/<database>/<algorithm>-<version>.sqlite3
# KB_CHUNK_DEDUP_INDEX=

# ---- Local runtime switches ---------------------------------------------------------------------------------
# Windows Application Control can block SQLAlchemy's compiled modules; the app then loads pure-Python sources.
# 0 = never, 1 = always, unset = automatic. Do not work around the policy any other way.
# KB_SQLALCHEMY_PURE_PYTHON=
# Embedding runs offline from the local Hugging Face cache after the one-time `embedding.cli download`.
# HF_HOME=C:\kb\hf-cache

# ---- GitHub: NOT production-enabled ------------------------------------------------------------------------
# This release is Common Crawl only. `run --sources github`, the GitHub worker and the GitHub planner REFUSE unless
# KB_ENABLE_GITHUB=1 (development builds only). Leave both unset in production; never commit a token.
# KB_ENABLE_GITHUB=
# KB_GH_TOKEN=
