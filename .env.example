# KB pipeline environment variables — NAMES AND PLACEHOLDERS ONLY.
#
# Copy to `.env` (which is git-ignored) or inject from a secrets store.
# NEVER put real passwords in this file or in any committed file.
# See docs/database_privileges_v1.md (roles) and docs/migrations_kbp.md.

# Migration / bootstrap connection. Role: kb_pipeline_migrator (owner of schema kbp).
# Used ONLY by Alembic migrations and approved bootstrap commands.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Preferred: omit ":<password>" and let libpq read it from a pgpass file kept
# outside the repository (see docs/migrations_kbp.md, live runbook step 5).
KB_MIGRATION_DATABASE_URL=postgresql+psycopg://kb_pipeline_migrator:CHANGE_ME@localhost:5432/data_collection_pipeline

# Runtime application connection. Role: kb_pipeline_app (least-privilege DML).
# Used by workers and Gold publication. Must differ from the migration URL.
KB_DATABASE_URL=postgresql+psycopg://kb_pipeline_app:CHANGE_ME@localhost:5432/data_collection_pipeline
