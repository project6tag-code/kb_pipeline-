# KB pipeline environment variables — NAMES AND PLACEHOLDERS ONLY.
#
# Copy to `.env` (which is git-ignored) or inject from a secrets store.
# NEVER put real passwords in this file or in any committed file.
# See docs/database_privileges_v1.md (roles) and docs/migrations_kbp.md.

# Migration / bootstrap connection. Role: kb_pipeline_migrator (owner of schema kbp).
# Used ONLY by Alembic migrations and approved bootstrap commands.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Preferred: omit ":<password>" and let libpq read it from a pgpass file kept
# outside the repository (see docs/migrations_kbp.md, live runbook step 5).
KB_MIGRATION_DATABASE_URL=postgresql+psycopg://kb_pipeline_migrator:CHANGE_ME@localhost:5432/data_collection_pipeline

# Runtime application connection. Role: kb_pipeline_app (least-privilege DML).
# Used by workers and Gold publication. Must differ from the migration URL.
KB_DATABASE_URL=postgresql+psycopg://kb_pipeline_app:CHANGE_ME@localhost:5432/data_collection_pipeline

# Common Crawl Acquisition V1 (optional; defaults shown; see docs/commoncrawl_acquisition_v1.md).
# No secrets. Endpoints are fixed in code and cannot be configured.
# KB_CC_CRAWL_WINDOW=1
# KB_CC_CRAWLS=
# KB_CC_BLOCKS_PER_PARTITION=10
# KB_CC_PARTITION_STRIDE=1
# KB_CC_MAX_PARTITIONS_PER_CRAWL=0
# KB_CC_MIME_TYPES=text/html,application/xhtml+xml
# KB_CC_LANGUAGES=eng
# KB_CC_REJECT_TRUNCATED=true
# KB_CC_MAX_RECORD_BYTES=5242880
# KB_CC_MAX_DECOMPRESSED_RECORD_BYTES=33554432
# KB_CC_BRONZE_ROOT=data/bronze/commoncrawl
# KB_CC_MIN_FREE_BYTES=10737418240
# KB_CC_FETCH_CONCURRENCY=4
# KB_CC_BATCH_SIZE=50
# KB_CC_CONNECT_TIMEOUT_SECONDS=10
# KB_CC_READ_TIMEOUT_SECONDS=30
# KB_CC_REQUEST_DEADLINE_SECONDS=120
# KB_CC_ITEM_TRANSIENT_LIMIT=3

# GitHub Acquisition V1 (optional; see docs/github_acquisition_v1.md). NEVER commit a token:
# set KB_GH_TOKEN only in your shell or secrets store.
# KB_GH_TOKEN=
# KB_GH_TOKEN_IDENTITY=
# KB_GH_CREATED_FROM=2010-01-01
# KB_GH_WINDOW_DAYS=30
# KB_GH_MAX_WINDOWS=0
# KB_GH_DISCOVERY_EPOCH=auto
# KB_GH_MIN_STARS=50
# KB_GH_MAX_REPO_SIZE_KB=200000
# KB_GH_ALLOW_FORKS=false
# KB_GH_ALLOW_ARCHIVED=false
# KB_GH_MAX_FILE_BYTES=1048576
# KB_GH_MAX_FILES_PER_SNAPSHOT=2000
# KB_GH_BRONZE_ROOT=data/bronze/github
# KB_GH_FETCH_CONCURRENCY=2
# KB_GH_QUOTA_RESERVE=50
