# --- Secrets: never commit real credentials ---------------------------------
.env
.env.*
!.env.example
*.pem
*.key
.pgpass

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ------------------------------------------------------
.venv/
venv/
env/

# --- Test / tooling caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local pipeline data and logs (large / environment-specific) ------------
logs/*
!logs/.gitkeep
data/bronze/**/*
!data/bronze/**/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
# Gold bridge `status` snapshots written by operators at the repo root (generated local audit output)
/bridge_*.json
# disposable chunk near-dedup candidate indexes (rebuildable from PostgreSQL)
data/chunk_dedup/*
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
# --- Database backups / exports ----------------------------------------------
backup/
*.dump
*.backup
*.bak
*.sql.gz
pgpass.conf
*.pfx
*.log

# --- Temporary/local runtime files -------------------------------------------
tmp/
temp/
*.tmp

# --- Local model/cache downloads ---------------------------------------------
.cache/
