# --- Secrets: never commit real credentials ---------------------------------
.env
.env.*
!.env.example
*.pem
*.key
.pgpass

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ------------------------------------------------------
.venv/
venv/
env/

# --- Test / tooling caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local pipeline data and logs (large / environment-specific) ------------
logs/*
!logs/.gitkeep
data/bronze/**/*
!data/bronze/**/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
